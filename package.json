{
  "name": "jarvis-travel-quote",
  "version": "1.0.0",
  "description": "AI-powered travel quote app with real prices",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "node server/dev-server.js",
    "build": "npm run build:client && npm run build:server",
    "build:client": "mkdir -p dist && cp -r src/* dist/",
    "build:server": "echo 'Server ready'",
    "start": "node server/index.js",
    "test": "node server/test-cases.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.45.0",
    "axios": "^1.6.0",
    "express": "^4.18.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "redis": "^4.6.0",
    "body-parser": "^1.20.0"
  },
  "devDependencies": {
    "concurrently": "^8.0.0"
  },
  "keywords": [
    "travel",
    "quotes",
    "ai",
    "claude",
    "mexico"
  ],
  "author": "Reuben",
  "license": "MIT"
}
